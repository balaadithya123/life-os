name: life-os-devwatch
on:
  schedule:
    - cron: "30 16 * * *" # 22:00 IST
  workflow_dispatch:
permissions:
  contents: write
concurrency:
  group: life-os-state
  cancel-in-progress: false
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
      - run: pip install -r requirements.txt
      - name: Read-only GitHub check
        run: python src/devwatch.py
        env:
          GH_PAT: ${{ secrets.GH_PAT }}
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
      - name: Save summary
        run: |
          git config user.name life-os-bot
          git config user.email bot@users.noreply.github.com
          git add state/dev.json
          git diff --cached --quiet || (git commit -m "devwatch $(date -u +%F-%H%M)" && git pull --rebase && git push)
